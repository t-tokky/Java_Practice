<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.portfolio.qiita_summary_notifier.repository.NotificationSettingMapper">
    <!-- 新規登録 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification_settings (
            user_id, 
            include_tags,
            exclude_tags,
            webhook_url,
            webhook_name,
            is_active,
            updated_at
        )
        VALUES (
            #{userId},
            #{includeTags},
            #{excludeTags},
            #{webhookUrl},
            #{webhookName},
            #{isActive},
            CURRENT_TIMESTAMP
        )
    </insert>
    <!-- 有効な通知設定を検索する -->
    <select id="selectActiveSettings" resultType="com.portfolio.qiita_summary_notifier.entity.NotificationSetting">
        SELECT * FROM notification_settings
        WHERE is_active = true
    </select>
    <!-- ユーザーごとの設定一覧取得する -->
    <select id="selectByUserId" resultType="com.portfolio.qiita_summary_notifier.entity.NotificationSetting">
        SELECT * FROM notification_settings
        WHERE user_id = #{userId}
    </select>
    <!-- 1件取得 -->
    <select id="selectById" resultType="com.portfolio.qiita_summary_notifier.entity.NotificationSetting">
        SELECT * FROM notification_settings
        WHERE id = #{id}
    </select>
    <!-- 設定を更新する -->
    <update id="update">
        UPDATE notification_settings SET 
            include_tags = #{includeTags},
            exclude_tags = #{excludeTags},
            webhook_url = #{webhookUrl},
            webhook_name = #{webhookName},
            is_active = #{isActive},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>
    <!-- 設定を削除する -->
    <delete id="delete">
        DELETE FROM notification_settings WHERE id = #{id}
    </delete>
</mapper>